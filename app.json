{
  "expo": {
    "name": "You & I",
    "slug": "pure-love",
    "scheme": "purelove",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0A09",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.purelove.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.purelove.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0A09",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick photos to share as moments with your partner.",
          "cameraPermission": "Snap photos to share as moments with your partner."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Moment",
              "label": "You & I moment",
              "description": "The latest moment from your partner",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 3,
              "targetCellHeight": 3,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "s-rakim",
    "extra": {
      "eas": {
        "projectId": "7d7df6cd-d059-4a5d-9828-daf904cec3b8"
      }
    }
  }
}
